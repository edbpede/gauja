# Gradle / Android
.gradle/
build/
local.properties
.kotlin/
captures/
*.hprof

# Xcode / SwiftPM (the .xcodeproj is generated by XcodeGen and never committed)
*.xcodeproj
*.xcworkspace
DerivedData/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate
*.ipa
*.dSYM.zip

# IDEs and editors
.idea/
.vscode/
.fleet/
*.iml
.DS_Store

# Local, never-committed fixture variants (PRD §4.5)
api/fixtures/**/*.local.*

# Secrets that must never be tracked
*.keystore
*.jks
*.p12
*.mobileprovision

# Contract tooling and isolated generation/build checks
.cache/

# Python build tooling caches
__pycache__/
*.py[cod]
