* text=auto eol=lf

# Store art, icons, fonts and archives are binary (design/assets/, store metadata).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.aab binary
*.apk binary
*.ipa binary
*.keystore binary
*.p12 binary

# Generated code is reviewed collapsed on GitHub; it is never hand-edited (PRD §12.2 rule 6).
apps/android/core/api/** linguist-generated=true
apps/ios/Packages/SeerrAPI/Generated/** linguist-generated=true
apps/android/core/designsystem/src/main/kotlin/**/generated/** linguist-generated=true
apps/ios/Packages/DesignSystem/Sources/DesignSystem/Generated/** linguist-generated=true
