{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": ["github-actions", "gradle", "swift", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "gitleaks binary pinned in pr-hygiene.yml (GITLEAKS_VERSION; update the SHA256 alongside)",
      "managerFilePatterns": ["/^\\.github/workflows/pr-hygiene\\.yml$/"],
      "matchStrings": ["GITLEAKS_VERSION:\\s*(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Hook revisions in prek.toml",
      "managerFilePatterns": ["/^prek\\.toml$/"],
      "matchStrings": ["repo = \"https://github\\.com/(?<depName>[^\"]+)\"\\s*\\n\\s*rev = \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-tags"
    }
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com",
    "300104067+engels74-bot@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "matchDepNames": ["gitleaks/gitleaks"],
      "automerge": false,
      "groupName": "gitleaks"
    }
  ],
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 10
}
