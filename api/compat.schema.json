{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gauja feature compatibility",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
  },
  "additionalProperties": {
    "type": "object",
    "required": [
      "min",
      "max",
      "endpoint",
      "note"
    ],
    "additionalProperties": false,
    "properties": {
      "min": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
      },
      "max": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          {
            "type": "null"
          }
        ]
      },
      "endpoint": {
        "type": "string",
        "pattern": "^/"
      },
      "note": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
