root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts,java,swift}]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json,json5,toml,xcstrings}]
indent_size = 2

[*.{sh,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
